{
  "name": "tourism-agent-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "serve": "node server.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "manual:ingest": "python3 scripts/manual_chat_ingest.py --once",
    "manual:watch": "python3 scripts/manual_chat_ingest.py --watch --interval 30",
    "manual:cron": "python3 scripts/manual_chat_ingest.py --once --quiet-idle",
    "video:ocr": "python3 scripts/video_chat_ocr.py",
    "amocrm:lead-urls": "python3 scripts/amocrm_export_lead_urls.py",
    "amocrm:browser-scrape": "node scripts/amocrm_browser_scrape.js",
    "video:upload-server": "node scripts/video_upload_server.js",
    "mango:calls": "python3 scripts/analyze_mango_calls.py"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "busboy": "^1.6.0",
    "express": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "jsdom": "latest",
    "playwright": "^1.62.0",
    "vitest": "latest"
  }
}
